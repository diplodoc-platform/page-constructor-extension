{
  "name": "@diplodoc/page-constructor-extension",
  "version": "0.13.11",
  "description": "Page constructor plugin for Diplodoc transformer and builder",
  "main": "build/plugin/index.js",
  "types": "build/plugin/index.d.ts",
  "engines": {
    "node": ">=24",
    "npm": ">=11.5.1"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:diplodoc-platform/page-constructor-extension.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./build/plugin/index.d.ts",
      "node": "./build/plugin/index-node.js",
      "default": "./build/plugin/index.js"
    },
    "./plugin": {
      "types": "./build/plugin/index.d.ts",
      "node": "./build/plugin/index-node.js",
      "default": "./build/plugin/index.js"
    },
    "./plugin/csr": {
      "types": "./build/plugin/index.d.ts",
      "node": "./build/plugin/index-node-csr.js",
      "default": "./build/plugin/index.js"
    },
    "./styles": "./build/index.css",
    "./runtime/styles": "./build/runtime/index.css",
    "./runtime": {
      "types": "./build/runtime/index.d.ts",
      "default": "./build/runtime/index.js"
    },
    "./react": {
      "types": "./build/react/index.d.ts",
      "default": "./build/react/index.js"
    },
    "./renderer": {
      "types": "./build/renderer/index.d.ts",
      "default": "./build/renderer/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "index.d.ts": [
        "./build/plugin/index.d.ts"
      ],
      "plugin": [
        "./build/plugin/index.d.ts"
      ],
      "runtime": [
        "./build/runtime/index.d.ts"
      ],
      "react": [
        "./build/react/index.d.ts"
      ],
      "renderer": [
        "./build/renderer/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:clean && run-p build:js build:declarations",
    "build:clean": "node scripts/clean.mjs",
    "build:declarations": "tsc -p tsconfig.publish.json --emitDeclarationOnly --outDir ./build",
    "build:js": "node esbuild/build.js",
    "lint": "lint",
    "lint:fix": "lint fix",
    "pre-commit": "lint-staged",
    "prepare": "husky || true",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --config vitest.config.mjs",
    "lock": "npm install --no-workspaces --package-lock-only --ignore-scripts"
  },
  "keywords": [
    "page-constructor",
    "markdown-it"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "build"
  ],
  "peerDependencies": {
    "@diplodoc/transform": "^4.76.10",
    "markdown-it": "^13.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@diplodoc/infra": "2.2.3",
    "@diplodoc/transform": "^4.77.5",
    "@hyrious/esbuild-plugin-commonjs": "^0.2.5",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.12",
    "@types/markdown-it": "^13.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "esbuild-sass-plugin": "^3.3.1",
    "esbuild-visualizer": "^0.7.0",
    "markdown-it": "^13.0.2",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@diplodoc/directive": "^0.3.4",
    "@diplodoc/utils": "^2.3.5",
    "@gravity-ui/page-constructor": "^8.14.2",
    "cheerio": "^1.0.0",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.21"
  }
}
