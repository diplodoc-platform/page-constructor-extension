{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "es2022",
    "module": "es2022",
    "declaration": true,
    "moduleResolution": "bundler"
  },
  "include": ["src"],
  "exclude": ["node_modules", "build", "example"],
  "ts-node": {
    "esm": true,
    "transpileOnly": true
  }
}
